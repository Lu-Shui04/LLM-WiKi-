# ─── 密钥（绝对不能提交）─────────────────────────────
.env
.env.local
.env.*.local

# ─── Python ──────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ─── 运行时数据（SQLite 库文件）──────────────────────
data/

# ─── Wiki 编译缓存 ───────────────────────────────────
# 含第一步分析的 JSON 缓存和每次 LLM 的原始输出，体积大且随时可重建
wiki/.cache/
# 待确认的编译产物：一次「上传但还没点确认」的暂存世界，结案即删。
# 它不是知识库的一部分，提交上去只会让 clone 下来的人看到一堆没生效的页面。
wiki/.staging/

# ─── 会话日志 ────────────────────────────────────────
# 本机跑出来的全链路追踪，体积会涨，而且里面带提问原文
logs/

# ─── 本地运行产物 ────────────────────────────────────
# 服务日志和提示词备份：都是本机跑出来的，提交上去只是噪声
.server.err.log
.server.out.log
.prompt-backup-*/

# ─── 工具缓存 ────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
