# 复制此文件为 .env 并填入真实值：copy .env.example .env
# 全项目只有 app/config.py 会读取这些变量，其他模块一律 from app.config import settings
# 自检命令：python -m app.config

# ─── DeepSeek 对话模型 ───────────────────────────────
# 申请：https://platform.deepseek.com
# 注意：官方模型名只有 deepseek-flash 和 deepseek-v4-pro。
#      deepseek-chat / deepseek-reasoner 是旧的静默别名，不推荐再用。
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ─── 智谱 AI（Embedding）─────────────────────────────
# 申请：https://open.bigmodel.cn  →  右上角 API Keys
ZHIPU_API_KEY=你的key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# embedding-3 支持 256 / 512 / 1024 / 2048 四档维度
# ⚠️ 维度是建表时固化的，改了必须重建索引（重新跑 ingest）
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIM=1024

# ─── PostgreSQL + pgvector ──────────────────────────
# pgvector 跑在 WSL 的 Docker 里，容器把 5432 映射出来，
# 所以在 Windows 上跑 uvicorn 时 PG_HOST 用 localhost。
# 如果哪天把后端也塞进 docker-compose，这里要改成服务名 postgres。
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=personal_agent
